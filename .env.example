# Google Drive API key (create one in Google Cloud Console and enable "Google Drive API")
GOOGLE_API_KEY=your_api_key_here

# Path to the Tesseract executable. Only needed if "tesseract" is not in your PATH.
# Windows example (remove the leading # to use it):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe